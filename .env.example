PORT=3002
PUBLIC_URL=https://people.kyvvo.com.br

# Postgres isolado deste serviço (nunca o mesmo banco do Kyvvo principal)
DATABASE_URL=postgres://user:password@localhost:5432/kyvvo_people
PGSSL=false

PEOPLE_JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Login: valida contra o serviço de auth do Kyvvo principal (POST /api/auth/login
# + GET /api/auth/people/acesso) — qualquer usuário Kyvvo com o módulo "people"
# ativo no tenant consegue entrar. Nenhuma credencial fica armazenada aqui.
KYVVO_APP_URL=https://studio.kyvvo.com.br

# Resend — env vars próprias deste serviço, nunca compartilhadas com o painel principal
RESEND_API_KEY=
RESEND_FROM=Kyvvo People <no-reply@kyvvo.com.br>

# Claude Haiku — parsing de currículo (#48). Mesma chave usada pelo bot de
# WhatsApp do Studio (ANTHROPIC_API_KEY), pode ser reaproveitada. Sem ela,
# a extração falha silenciosamente e curriculo_estruturado fica vazio —
# não bloqueia candidatura nenhuma.
ANTHROPIC_API_KEY=
